{
    "name": "axitdev/phpunit-ai-evals",
    "description": "Framework-agnostic AI Evals, LLM-as-a-Judge & Smart VCR for PHPUnit",
    "type": "library",
    "license": "MIT",
    "keywords": ["phpunit", "llm", "ai", "evals", "llm-as-a-judge", "vcr", "testing", "openai", "anthropic", "gemini", "ollama"],
    "authors": [
        {
            "name": "Oleksii Ivanov",
            "email": "axitdev@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/axitdev/phpunit-ai-evals/issues",
        "source": "https://github.com/axitdev/phpunit-ai-evals"
    },
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "php-http/discovery": "^1.20",
        "phpunit/phpunit": "^12.5 || ^13.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0"
    },
    "suggest": {
        "opis/json-schema": "Needed for assertMatchesJsonSchema() (^2.4)"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "infection/infection": "^0.35.8",
        "nyholm/psr7": "^1.8.2",
        "opis/json-schema": "^2.4",
        "phpstan/phpstan": "^2.1",
        "symfony/http-client": "^7.3"
    },
    "autoload": {
        "psr-4": {
            "Axitdev\\PhpUnitAiEvals\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Axitdev\\PhpUnitAiEvals\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse",
        "cs": "php-cs-fixer check --diff",
        "cs-fix": "php-cs-fixer fix",
        "infection": "infection --threads=max"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false,
            "infection/extension-installer": true
        }
    }
}
